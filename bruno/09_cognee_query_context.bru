meta {
  name: Cognee GraphRAG Pre-Flight Query
  type: http
  seq: 9
}

post {
  url: {{baseUrl}}/query-context
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  X-OpenRouter-Key: {{openRouterApiKey}}
}

body:json {
  {
    "question": "Which parts use 17-4PH and need certs?",
    "sources": ["BOM_RevC.xlsx", "RFQ_Package_Meridian.pdf"]
  }
}

assert {
  res.status: eq 200
  res.body.passed: eq true
  res.body.citations: isDefined
}
